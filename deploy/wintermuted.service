[Unit]
Description=Wintermute server (assistant API and browser UI)
Documentation=https://github.com/leddown/wintermute
After=network-online.target
Wants=network-online.target

# After=ollama.service
# After=llama-swap.service

# Uncomment whichever model backend runs on this same host under systemd, so
# the first probe at startup finds it up rather than recording it unreachable
# and waiting for a refresh.


[Service]
Type=simple
User=wintermute
Group=wintermute
EnvironmentFile=/etc/wintermute/wintermute.env
ExecStart=/usr/local/bin/wintermuted
Restart=on-failure
RestartSec=5


StateDirectory=wintermute
WorkingDirectory=/var/lib/wintermute

# The SQLite database lives here: StateDirectory creates /var/lib/wintermute
# owned by the service user on start, and it is the only writable path the
# service has under ProtectSystem=strict. WINTERMUTE_DB must point inside it.
#
# The model repository is the other writable path, when WINTERMUTE_MODEL_REPO
# points outside /var/lib/wintermute — an external drive is the usual case.
# ProtectSystem=strict makes everything except StateDirectory read-only, so
# without a line like this the repository is readable and every download fails
# with permission denied on a directory that works perfectly from a shell.
# Uncomment and match it to WINTERMUTE_MODEL_REPO. Note the leading '-':
#
#   ReadWritePaths=-/mnt/usb-drive/wintermute
#
# The '-' makes a missing path a warning instead of a fatal error, and it is
# not optional here. Without it, a directory that is not there fails namespace
# setup before the binary is executed at all — status=226/NAMESPACE, no log of
# its own, and nothing about the message says which of the paths in this unit
# it meant. A repository that has gone missing is a server that cannot
# download; it should not be a server that cannot start, because that is also
# the server whose UI initialises the repository.
#
# If the drive is mounted by systemd, require it too, so the service does not
# start against a bare mount point and find the repository uninitialised. Note
# the section: RequiresMountsFor= is a [Unit] setting, and systemd answers it
# in the wrong section with "Unknown key name ... ignoring" in the journal and
# nothing at all in the unit's status — a dependency that reads as present in
# the file and does not exist:
#
#   [Unit]
#   RequiresMountsFor=/mnt/usb-drive
#
# In a drop-in that means both sections, since ReadWritePaths= above is
# [Service]. A drop-in also *adds* to ReadWritePaths= rather than replacing it,
# so clear the list with a bare assignment first if this unit already sets it:
#
#   [Unit]
#   RequiresMountsFor=/mnt/usb-drive
#
#   [Service]
#   ReadWritePaths=
#   ReadWritePaths=-/mnt/usb-drive/wintermute
#
# The directory itself is made and blessed by `wintermuted -init-repo`, run as
# the service user. Deleting the drive's contents is what makes this necessary
# again, and it does not need the server running.


NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# ProtectHome is why the server never touches a user's files — that is the
# whole point of the split, and the client harness is what reaches a NAS share.
# So it has no business in /home, and this makes that structural rather than a
# promise.
#
# Deliberately NOT set: PrivateDevices=true. The hardware report shells out to
# nvidia-smi, which needs /dev/nvidia*. With PrivateDevices=true the GPU section
# of GET /api/v1/system comes back empty and every VRAM fit estimate silently
# falls back to "unknown" — which looks like a missing driver rather than a
# sandbox setting, and is a genuinely annoying afternoon to debug.


CapabilityBoundingSet=

# Nothing here binds a privileged port under the shipped configuration
# (WINTERMUTE_ADDR defaults to :8088 in the env file), so the service needs no
# capabilities at all. If you move it to port 80 or 443, add BOTH of these —
# an ambient capability must also be in the bounding set, so granting it while
# the set above stays empty leaves the service unable to bind and looks like
# the capability was ignored:
#
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE


[Install]
WantedBy=multi-user.target
