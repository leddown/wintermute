# Wintermute server environment, read by systemd as an EnvironmentFile.
#
# This is not a shell script: systemd takes each line literally, so do not
# quote values unless you want the quotes, and do not use $VAR expansion.
# scripts/setup.sh writes a filled-in copy of this to
# /etc/wintermute/wintermute.env, mode 600, owned by the service user.
#
# Each setting comes first and the paragraph explaining it sits underneath: the
# name is what you are scanning for, the prose is what you read once you have
# found it.

WINTERMUTE_BACKENDS=/etc/wintermute/backends.json

# Where the backend declaration lives.
#
# Set this. Without it the server looks for ./backends.json relative to its
# working directory, does not find one, and quietly falls back to building a
# single backend from the variables below — so a carefully written multi-backend
# file sits there being ignored, and the only symptom is that the pool and any
# non-default backend have vanished.


WINTERMUTE_ADDR=:8088

# Listen address for the JSON API and the browser UI.
#
# Port 8088 rather than the binary's own default of 8080, because 8080 is what
# llama.cpp's llama-server and llama-swap listen on. On a host that serves its
# own models the two collide and whichever starts second fails to bind.


WINTERMUTE_DB=/var/lib/wintermute/wintermute.db

# SQLite file. Must be inside /var/lib/wintermute: under ProtectSystem=strict
# in the shipped unit that is the only writable path the service has, and
# StateDirectory=wintermute is what creates it, owned by the service user.


WINTERMUTE_METRICS_DB=/var/lib/wintermute/metrics.db

# Fleet telemetry, in its own database file.
#
# Optional, but nothing about the fleet works without it: remote hosts report
# through POST /api/v1/nodes/report, and with this unset that endpoint answers
# 503 and every agent logs a failure. The node model stores ride on the same
# report, so an unset value also means no node ever learns what it has been
# assigned — which looks like a broken agent rather than a missing variable.
#
# Separate from WINTERMUTE_DB on purpose: telemetry arrives constantly, is worth
# little within days, and would inflate every backup of the conversation memory.
# This file can be pruned hard or deleted outright without losing anything that
# matters. Must be inside /var/lib/wintermute, like the main database.


WINTERMUTE_NODE_AGENT_DIR=/var/lib/wintermute/node-agent

# The built fleet agent, which a new host installs from over HTTP:
#
#   curl -fsSL -H "Authorization: Bearer $TOKEN" SERVER/api/v1/node-agent/install.sh \
#     | sudo sh -s -- --token "$TOKEN"
#
# scripts/setup.sh and update.sh cross-compile the agent for linux/amd64 and
# linux/arm64 into this directory on the same pass that builds the server, so a
# node always installs an agent from the commit the server is running.
#
# Unset turns the install endpoints off, and they say so rather than 404ing. The
# agent never reads this: it does not fetch its own executable, and nothing here
# is reachable from its reporting loop. An operator runs the installer; a server
# that could replace the binary on every node would be root on the whole fleet.


# WINTERMUTE_MODEL_REPO=/mnt/usb-drive/wintermute

# The model repository: where downloaded weights are kept.
#
# Unset means the Repository screen reports itself as not configured and no
# model can be downloaded or assigned to a node. An absolute path, and in
# practice the mount point of a drive with room for tens of gigabytes.
#
# Two things to get right, and neither announces itself:
#
#  1. The shipped unit runs under ProtectSystem=strict, which makes the whole
#     filesystem read-only apart from StateDirectory. A path outside
#     /var/lib/wintermute needs a matching ReadWritePaths= line in the unit —
#     see wintermuted.service — or every download fails with permission denied
#     on a directory that is plainly writable from a shell.
#  2. The server refuses to write here until the directory carries a
#     .wintermute-repo marker, created by pressing Initialise in
#     Admin -> Repository. That is deliberate: an unmounted USB drive leaves
#     its mount point behind as an ordinary empty directory, and without the
#     marker a download would quietly fill the root filesystem instead.


WINTERMUTE_LLM_TIMEOUT=10m

# Bound on a single completion. Ten minutes is generous for a cloud API and not
# especially generous for a 12B model working through several tool calls on a
# partially offloaded card. Raise it before concluding a local backend is broken
# — and raise it well above this if you have configured a cloud fallback, or a
# slow local turn will be mistaken for a failure and sent off the network.


WINTERMUTE_LLM_MAX_TOKENS=16000

# Cap on one response, the model's thinking included.


WINTERMUTE_MAX_TOOL_ITERATIONS=12

# Tool round-trips allowed in a single turn before the loop gives up.


LLAMA_API_KEY=
ANTHROPIC_API_KEY=

# API keys referenced by name from backends.json. A backend entry names the
# variable in its "api_key_env" field rather than carrying the key itself, so
# backends.json can be committed or shared and this file is the only secret.
#
# Set whichever your backends actually use.


HUGGINGFACE_TOKEN=

# Optional. Only needed to search gated Hugging Face repositories; public model
# search works without it.

# ---- twire, the canary tripwire --------------------------------------------
#
# All optional — with none of this set, canaries still listen and record hits,
# and only the email alerting is off.

WINTERMUTE_SECRET=

# The key twire encrypts a stored SMTP App Password with. This is the only
# secret wintermute keeps at rest and is able to read back again; everything
# else it needs is either hashed (client tokens) or taken straight from this
# file at startup. Without it the canaries work and alerting can still be
# configured from the SMTP_* variables below, but the Email alerts form refuses
# to save a password rather than writing one it cannot protect.
#
# Any long random string. Generate one with:  openssl rand -base64 32
# Changing it makes an already-saved password unrecoverable — re-enter it in
# the UI afterwards.


SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Seed values for canary alerts, sent through Google SMTP (smtp.gmail.com:587,
# hard-coded). A configuration saved in the UI overrides these from then on.
# SMTP_PASSWORD must be a Google App Password; Google rejects account
# passwords here.


TWIRE_ALERT_TO=

# Comma-separated.
